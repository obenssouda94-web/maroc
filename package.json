{
  "name": "maroc",
  "version": "1.0.0",
  "private": true,
  "description": "MAROC — The Digital Kingdom. Multilingual national knowledge platform about the Kingdom of Morocco.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "db:push": "prisma db push",
    "db:push:sqlite": "prisma db push --schema prisma/schema.sqlite.prisma",
    "db:generate:sqlite": "prisma generate --schema prisma/schema.sqlite.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup:sqlite": "prisma db push --schema prisma/schema.sqlite.prisma && tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:studio:sqlite": "prisma studio --schema prisma/schema.sqlite.prisma"
  },
  "dependencies": {
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "next-themes": "^0.4.4",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "fuse.js": "^7.1.0",
    "zod": "^3.25.76",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^0.544.0",
    "framer-motion": "^12.23.22",
    "recharts": "^2.15.4",
    "@prisma/client": "^6.16.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.markercluster": "^1.5.6",
    "@tailwindcss/postcss": "^4",
    "tailwindcss": "^4",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "@eslint/eslintrc": "^3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.6",
    "prisma": "^6.16.1"
  }
}
